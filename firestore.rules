rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {

      function isValidProfile(data) {
        let allowedKeys = [
          'coinBalance', 'luckyScore', 'totalPlays', 'winStreak', 'history',
          'wheelSpinDate', 'wheelDailySpinsUsed', 'wheelPaidSpinsUsed',
          'displayName', 'photoURL', 'updatedAt',
          'xp', 'level', 'shakeStreak', 'shakeStreakLastClaimed', 'shakeStreakRecord',
          'weeklyCoins', 'weeklyCoinsLastUpdated', 'collectedItems', 'mysteryBoxesCount',
          'badges', 'doubleRewardsUntil', 'streakShieldsCount', 'vipUntil',
          'lastVisitDate', 'visitStreak', 'visitStreakRecord', 'zodiacSign',
          'lastAstroClaimDate', 'lastWishDate', 'lastTimeCapsuleDate',
          'totalDiceRolls', 'totalGoldenDiceEvents', 'goldenDiceRate',
          'highestRewardWon', 'highestRewardPoints', 'legendaryRewardsCount',
          'equippedDice', 'diceFragments', 'collectionProgress', 'mythicDiceCount',
          'coinDailyAttempts', 'coinDailyAttemptsDate', 'coinTotalWins', 'coinTotalLosses',
          'coinTotalPredictions', 'coinWinStreak', 'coinBestStreak', 'coinLargestWin',
          'coinTotalProfit', 'scratchAttemptsUsed', 'scratchDate', 'scratchPrizeWon',
          'giftHuntBoard', 'giftHuntTotalOpened', 'giftHuntHighestGift', 'giftHuntTimes1000',
          'giftHuntTimes5000', 'dailyShakesToday', 'extraShakesBalance', 'shakeSpinDate',
          'collectibles', 'diceRollDate', 'diceRollsUsed', 'pendulumDailyQuestionsDate',
          'pendulumDailyQuestionsUsed', 'giftHuntDate', 'giftHuntOpensUsed', 'localVersion'
        ];
        
        return data.keys().hasOnly(allowedKeys)
            && data.coinBalance is int
            && data.coinBalance >= 0
            && data.luckyScore is int
            && data.luckyScore >= 0
            && data.luckyScore <= 100
            && data.totalPlays is int
            && data.totalPlays >= 0
            && data.winStreak is int
            && data.winStreak >= 0
            && data.wheelDailySpinsUsed is int
            && data.wheelDailySpinsUsed >= 0
            && data.wheelDailySpinsUsed <= 20
            && data.wheelPaidSpinsUsed is int
            && data.wheelPaidSpinsUsed >= 0
            && data.wheelPaidSpinsUsed <= 10
            && data.wheelSpinDate is string
            && data.wheelSpinDate.size() == 10
            && data.history is list
            && data.history.size() <= 20
            
            // ✅ Optional Identity Fields
            && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 50))
            && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2083))
            
            // ✅ Golden Dice profile statistics
            && (!('totalDiceRolls' in data) || (data.totalDiceRolls is int && data.totalDiceRolls >= 0))
            && (!('totalGoldenDiceEvents' in data) || (data.totalGoldenDiceEvents is int && data.totalGoldenDiceEvents >= 0))
            && (!('goldenDiceRate' in data) || (data.goldenDiceRate is int || data.goldenDiceRate is float) && data.goldenDiceRate >= 0 && data.goldenDiceRate <= 1)
            && (!('highestRewardWon' in data) || (data.highestRewardWon is string && data.highestRewardWon.size() <= 100))
            && (!('highestRewardPoints' in data) || (data.highestRewardPoints is int && data.highestRewardPoints >= 0))
            && (!('legendaryRewardsCount' in data) || (data.legendaryRewardsCount is int && data.legendaryRewardsCount >= 0))

            // ✅ Dice Collection profile statistics
            && (!('equippedDice' in data) || (data.equippedDice is string && data.equippedDice.size() <= 64))
            && (!('diceFragments' in data) || (data.diceFragments is int && data.diceFragments >= 0))
            && (!('collectionProgress' in data) || (data.collectionProgress is int && data.collectionProgress >= 1))
            && (!('mythicDiceCount' in data) || (data.mythicDiceCount is int && data.mythicDiceCount >= 0));
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid && isValidProfile(request.resource.data);
      
      // Owners can update their profile.
      // Non-owners (when voting on wishes) can only update the luckyScore field, keeping all other fields unchanged.
      // We limit the non-owner change strictly to +/- 3 luckyScore to prevent arbitrary score manipulation.
      allow update: if request.auth != null && (
        (request.auth.uid == uid && isValidProfile(request.resource.data))
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['luckyScore'])
          && request.resource.data.luckyScore is int
          && request.resource.data.luckyScore >= 0
          && request.resource.data.luckyScore <= 100
          && (
            request.resource.data.luckyScore - resource.data.luckyScore == 3 
            || request.resource.data.luckyScore - resource.data.luckyScore == -3
            || (request.resource.data.luckyScore == 100 && request.resource.data.luckyScore - resource.data.luckyScore > 0 && request.resource.data.luckyScore - resource.data.luckyScore <= 3)
            || (request.resource.data.luckyScore == 0 && request.resource.data.luckyScore - resource.data.luckyScore < 0 && request.resource.data.luckyScore - resource.data.luckyScore >= -3)
          )
        )
      );
      allow delete: if request.auth != null && request.auth.uid == uid;

      match /goldenDiceEvents/{eventId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // ─── Collectible Dice Collection subcollection ────────────────────────
      match /diceCollection/{diceId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null 
                              && request.auth.uid == uid
                              && request.resource.data.id is string
                              && request.resource.data.name is string
                              && request.resource.data.rarity is string
                              && request.resource.data.unlockedAt is string;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      // ─── Time Capsules subcollection ─────────────────────────────────────
      match /timeCapsules/{capsuleId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        // Principal must be positive, multiplier within valid bounds, initialized to isOpened == false
        allow create: if request.auth != null 
                      && request.auth.uid == uid
                      && request.resource.data.userId == uid
                      && request.resource.data.coinsLocked is int
                      && request.resource.data.coinsLocked >= 10
                      && request.resource.data.multiplier is float
                      && request.resource.data.multiplier >= 1.0
                      && request.resource.data.multiplier <= 2.5
                      && request.resource.data.messageText is string
                      && request.resource.data.messageText.size() <= 500
                      && request.resource.data.isOpened == false;
        // Players cannot modify text, coins, or multiplier after creation. Only toggle isOpened from false -> true.
        allow update: if request.auth != null
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOpened'])
                      && resource.data.isOpened == false
                      && request.resource.data.isOpened == true;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if request.auth != null 
                    && request.resource.data.userUid == request.auth.uid
                    && request.resource.data.rewardName is string
                    && request.resource.data.rewardName.size() <= 100
                    && request.resource.data.rewardEmoji is string
                    && request.resource.data.rewardEmoji.size() <= 10
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 200;
      allow update, delete: if false;
    }

    // ─── Wishing Tree Collection ──────────────────────────────────────────
    match /wishes/{wishId} {
      allow read: if true; // anyone can browse wishes (including guest users)
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.wishText is string
                    && request.resource.data.wishText.size() <= 120
                    && request.resource.data.vibesCount == 0
                    && request.resource.data.vibesUsers is list
                    && request.resource.data.vibesUsers.size() == 0
                    && request.resource.data.isAnonymous is bool;
      
      allow update: if request.auth != null 
                    && (
                      // 1. Upvote / Downvote flow: Only affect vibes fields.
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vibesUsers', 'vibesCount'])
                        && (
                          // Upvoting: increment count by 1, append voter's uid
                          (request.resource.data.vibesCount == resource.data.vibesCount + 1 
                           && request.resource.data.vibesUsers.size() == resource.data.vibesUsers.size() + 1
                           && request.resource.data.vibesUsers.hasAll([request.auth.uid])
                           && !resource.data.vibesUsers.hasAny([request.auth.uid]))
                          ||
                          // Downvoting/Undoing: decrement count by 1, remove voter's uid
                          (request.resource.data.vibesCount == resource.data.vibesCount - 1 
                           && request.resource.data.vibesUsers.size() == resource.data.vibesUsers.size() - 1
                           && !request.resource.data.vibesUsers.hasAny([request.auth.uid])
                           && resource.data.vibesUsers.hasAny([request.auth.uid]))
                        )
                      )
                      // 2. Owner edits: Owner can only edit wish text and anonymity, not vote tallies.
                      || (
                        resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wishText', 'isAnonymous'])
                        && request.resource.data.wishText is string
                        && request.resource.data.wishText.size() <= 120
                        && request.resource.data.isAnonymous is bool
                      )
                    );
      
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || !('timestamp' in resource.data)
        || !(resource.data.timestamp is timestamp)
        || request.time > resource.data.timestamp + duration.value(24, 'h')
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
